# =============================================================================
# ARTSY PRODUCTION — ENVIRONMENT VARIABLES TEMPLATE (.env.local.example)
# =============================================================================
# All secrets must remain in .env.local and NEVER be committed to version control.
# Copy this file to .env.local and fill in your actual production/staging values.

# -----------------------------------------------------------------------------
# 1. STATUTORY & REGULATORY COMPLIANCE (GST, TDS, DPDP ACT, COOKIE SECURITY)
# -----------------------------------------------------------------------------
# Artsy Production 15-digit GSTIN (SAC 999613, 18% GST)
ARTSY_GSTIN=27AAAAA0000A1Z5

# Artsy Production 10-character Permanent Account Number (PAN)
ARTSY_PAN=AAAAA0000A

# AES-256-GCM encryption key (32+ chars) for PII (PAN, Bank Account, IFSC) at rest
# Mandated by Digital Personal Data Protection (DPDP) Act 2023
PII_ENCRYPTION_KEY=your_secure_32_character_encryption_secret_key_here

# 32-byte hexadecimal data encryption key
DATA_ENCRYPTION_KEY_32B=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 signature secret for signed session cookies (artsy_auth)
# Prevents unsigned cookie injection and session tampering
COOKIE_SIGNING_SECRET=your_long_random_cookie_signing_secret_here_min_32_chars

# -----------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth, Row-Level Security, WORM Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 3. RAZORPAY (Payment Gateway, Webhooks, Escrow-style Payouts)
# -----------------------------------------------------------------------------
# Client-side Razorpay Key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Server-side Razorpay Key ID & Secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Webhook Secret for validating X-Razorpay-Signature
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# 4. WHATSAPP GATEWAY (OpenWA Self-Hosted WhatsApp API + Baileys Anti-Ban)
# -----------------------------------------------------------------------------
# Local or containerized OpenWA instance URL
WHATSAPP_GATEWAY_URL=http://localhost:2785
# API operator key for OpenWA
WHATSAPP_GATEWAY_API_KEY=owa_k1_your_operator_key_here
# Active session UUID connected in OpenWA dashboard
WHATSAPP_SESSION_ID=your-session-uuid-here
# Studio dedicated WhatsApp business phone number
DEDICATED_WHATSAPP_NUMBER=917777078742
NEXT_PUBLIC_DEDICATED_WHATSAPP_NUMBER=917777078742
# Set to 'false' to use real OpenWA gateway, or 'true' to mock WhatsApp in local testing
MOCK_WHATSAPP=false
# Master API authentication token for internal WhatsApp dispatch routes
API_MASTER_KEY=your_api_master_key_here

# Meta WhatsApp Cloud API (Alternative/Fallback track)
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-meta-verify-token

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend - OTP Auth Fallback & Invoices)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM="Artsy Production <billing@artsyproduction.in>"

# -----------------------------------------------------------------------------
# 6. RAW FOOTAGE & VAULT STORAGE (Backblaze B2 + Cloudflare CDN)
# -----------------------------------------------------------------------------
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-app-key
B2_BUCKET_NAME=artsy-production-raw-footage
B2_BUCKET_ID=your-b2-bucket-id
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
NEXT_PUBLIC_CLOUDFLARE_CDN_URL=https://cdn.artsyproduction.in

# -----------------------------------------------------------------------------
# 7. VIDEO STREAMING & PREVIEW (Bunny Stream HLS)
# -----------------------------------------------------------------------------
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key
BUNNY_STREAM_LIBRARY_ID=your-bunny-stream-library-id
BUNNY_STREAM_CDN_HOSTNAME=video.artsyproduction.in

# -----------------------------------------------------------------------------
# 8. RATE LIMITING & CACHING (Upstash Redis)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# 9. CRON JOBS & SCHEDULED RECONCILIATION
# -----------------------------------------------------------------------------
# Bearer secret for securing Vercel Cron endpoints (/api/cron/*)
CRON_SECRET=your-random-long-cron-secret-token

# -----------------------------------------------------------------------------
# 10. ERROR MONITORING & APPLICATION CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id