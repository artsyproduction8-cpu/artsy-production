# =============================================================================
# ARTSY PRODUCTION — ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# All secrets must remain in .env.local and NEVER committed to version control.

# -----------------------------------------------------------------------------
# 1. SUPABASE (Database, Auth, Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 2. APPLICATION & URLS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 3. RAZORPAY (Payments & Webhooks)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# 4. BUNNY STREAM (Video Preview & HLS Streaming)
# -----------------------------------------------------------------------------
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key
BUNNY_STREAM_LIBRARY_ID=your-bunny-stream-library-id
BUNNY_STREAM_CDN_HOSTNAME=video.artsyproduction.com

# -----------------------------------------------------------------------------
# 5. BACKBLAZE B2 (Raw Footage Storage) + CLOUDFLARE CDN
# -----------------------------------------------------------------------------
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-app-key
B2_BUCKET_NAME=artsy-production-raw-footage
B2_BUCKET_ID=your-b2-bucket-id
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
NEXT_PUBLIC_CLOUDFLARE_CDN_URL=https://cdn.artsyproduction.com

# -----------------------------------------------------------------------------
# 6. NOTIFICATIONS (WhatsApp Cloud API - Meta Graph API v20.0 + SMS Fallback)
# -----------------------------------------------------------------------------
META_WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=your-meta-access-token
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-business-account-id
MOCK_WHATSAPP=true

# MSG91 (SMS Fallback for OTP and Critical Delivery Alerts)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-otp-template-id
MSG91_SENDER_ID=ARTSYP

# -----------------------------------------------------------------------------
# 7. EMAIL (Resend - Invoices & Formal Notices)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Artsy Production <billing@artsyproduction.com>"

# -----------------------------------------------------------------------------
# 8. RATE LIMITING & SECURITY (Upstash Redis & AES Encryption)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# 32+ character key for encrypting PAN, Bank Account, and IFSC at rest (AES-256-GCM / DPDP Act)
PII_ENCRYPTION_KEY=your_secure_32_character_encryption_secret_key_here
DATA_ENCRYPTION_KEY_32B=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret for securing Vercel Cron endpoints (/api/cron/*) - Generate with openssl rand -hex 32
CRON_SECRET=your-random-long-cron-secret-token

# -----------------------------------------------------------------------------
# 9. MONITORING (Sentry Error Tracking & Uptime)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id